# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<prosjekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Bare server-side. Brukes av API-rutene for å skrive tokens og kjøre agent-jobber.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- Claude API -----------------------------------------------------------
ANTHROPIC_API_KEY=<api key>

# --- Microsoft 365 / Entra ID (multitenant appregistrering) ---------------
# Se docs/azure-app-registration.md
MS_CLIENT_ID=<application (client) id>
MS_CLIENT_SECRET=<client secret value>
# Multitenant for jobbkontoer => "organizations". Bruk "common" bare om
# appregistreringen også tillater personlige Microsoft-kontoer, eller en
# tenant-id om den er single-tenant.
MS_TENANT=organizations
MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
