# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<prosjekt>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>
# Bare server-side. Brukes av API-rutene for å skrive tokens og kjøre agent-jobber.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# --- Claude API -----------------------------------------------------------
ANTHROPIC_API_KEY=<api key>
# Motoren selskaper uten eget valg kjører tilbudsagenten på: v2 (dagens) eller
# v3 (omfang først, så pris). Per selskap overstyres den under Tilbud →
# Innstillinger → Motor. Tilbakerulling = sett tilbake til v2. Se lib/claude/motor.ts.
MOTOR_DEFAULT=v2

# --- Microsoft 365 / Entra ID (multitenant appregistrering) ---------------
# Se docs/azure-app-registration.md
MS_CLIENT_ID=<application (client) id>
MS_CLIENT_SECRET=<client secret value>
# Multitenant for jobbkontoer => "organizations". Bruk "common" bare om
# appregistreringen også tillater personlige Microsoft-kontoer, eller en
# tenant-id om den er single-tenant.
MS_TENANT=organizations
MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# --- PowerOffice Go (leverandørfakturaer inn på ordren) -------------------
# Application key og subscription key er Devello sine, én per miljø, fra
# developer.poweroffice.net. Client key er per kunde og ligger i databasen
# (accounting_connections) — aldri her. Produksjonstilgang krever at
# PowerOffice har godkjent Devello som integrasjonspartner.
POGO_APPLICATION_KEY=<application key, produksjon>
POGO_SUBSCRIPTION_KEY=<subscription key, produksjon>
POGO_DEMO_APPLICATION_KEY=<application key, demo>
POGO_DEMO_SUBSCRIPTION_KEY=<subscription key, demo>

# --- Boligmappa (dokumentasjon til eiendommens Boligmappa) ----------------
# Client id og secret er Devello sine, fra Boligmappa. Kunden logger inn med
# sin egen Boligmappa Bedrift-bruker (OAuth); tokens ligger i databasen
# (boligmappa_connections) — aldri her. Redirect-URI-en må være registrert
# hos Boligmappa. staging før produksjon: integrasjonen må verifiseres av
# Boligmappa før den slippes på ekte eiendommer.
BOLIGMAPPA_CLIENT_ID=<client id>
BOLIGMAPPA_CLIENT_SECRET=<client secret>
BOLIGMAPPA_ENV=staging
BOLIGMAPPA_REDIRECT_URI=http://localhost:3000/api/boligmappa/auth/callback

# --- Autentisering --------------------------------------------------------
# Krev at nye brukere bekrefter e-postadressen før de kommer inn. Krever egen
# SMTP i Supabase — se docs/smtp-oppsett.md. La stå av til det er på plass:
# uten SMTP er Supabase sin innebygde e-post så ratebegrenset at kunder blir
# stengt ute.
AUTH_REQUIRE_EMAIL_CONFIRMATION=false

# --- E-post fra oss selv --------------------------------------------------
# Innloggingslenker sendes herfra, ikke gjennom Supabase. Supabase svarer 200
# uansett hva som skjer med meldingen etterpå; Resend sier fra. Se
# docs/smtp-oppsett.md for hvordan domenet verifiseres.
RESEND_API_KEY=<re_... fra resend.com>
# Må ligge på det verifiserte domenet.
EPOST_AVSENDER=Devello <ingen-svar@devello.no>

# --- App ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
