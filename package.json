{
  "name": "devello-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "install:chromium": "playwright-core install chromium",
    "preview:pdf": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/preview-pdf.ts",
    "test:agent": "node --env-file=.env.local --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/test-agent.ts",
    "test:perioder": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/test-perioder.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.12.1",
    "next": "^16.3.1",
    "pdf-parse": "^2.4.5",
    "playwright-core": "^1.56.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
