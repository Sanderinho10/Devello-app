# Kopier til .env (leses av `npx expo start`). Samme verdier som nettappens
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY. Anon-nøkkelen er
# offentlig — den gir ingenting uten et gyldig JWT.
EXPO_PUBLIC_SUPABASE_URL=https://<prosjekt>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Nettappen: lokalt http://<din-maskin-ip>:3000 (telefonen kan ikke nå localhost), i drift https://app.devello.no
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
